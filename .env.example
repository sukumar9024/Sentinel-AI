# Run python3 scripts/bootstrap.py to generate unique local values.
JWT_SECRET=replace-with-at-least-32-random-characters
COLLECTOR_KEY=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-unique-12-character-password
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DEMO_ENABLED=true
# DATABASE_URL=sqlite:///./sentinel.db
# REDIS_URL=redis://localhost:6379/0

# Optional local integrations. All external delivery and AI calls are disabled by default.
OPENSEARCH_URL=
OPENSEARCH_AWS_AUTH=false
AWS_REGION=ap-south-2
AI_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
AI_MAX_DAILY_REQUESTS=100
NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true
EVENT_RETENTION_DAYS=30
JOB_RETENTION_DAYS=7
